# ============================================
# TunnBox - Environment Configuration
# Copy to .env next to docker-compose.yml
# ============================================

# ---------- Required ----------
# Public IP address or hostname that VPN clients connect to (no port; the port is per interface).
# Can be changed later under Settings > General.
WG_DEFAULT_ENDPOINT=vpn.example.com

# ---------- Strongly recommended ----------
# Root secret for session signing and encryption of stored private keys.
# Generate with: openssl rand -hex 32
# If left empty, TunnBox generates one on first start and stores it in ./data/app/.secret_key
SECRET_KEY=

# ---------- Optional ----------
# Default DNS server(s) handed to VPN clients (comma-separated). Editable in Settings.
WG_DEFAULT_DNS=1.1.1.1

# Session lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Brute-force protection
LOGIN_RATE_LIMIT=10/minute
LOCKOUT_THRESHOLD=8
LOCKOUT_MINUTES=15

# Allow PostUp/PostDown commands on interfaces. They run as root inside the container.
WG_ALLOW_CUSTOM_SCRIPTS=false

# Reverse proxy IPs/CIDRs trusted to set X-Forwarded-For and X-Forwarded-Proto
# Example for the default Docker bridge: 172.16.0.0/12
TRUSTED_PROXIES=

# Secure cookies: auto (on when served over HTTPS), true, or false
COOKIE_SECURE=auto

# Stats sampling and retention
STATS_SAMPLE_SECONDS=30
STATS_RETENTION_DAYS=90

# Logging: text or json
LOG_FORMAT=text

# ---------- Development only ----------
# Backend mode: auto (real on Linux with wg installed, otherwise mock), real, or mock
# WG_BACKEND_MODE=auto
# WG_CONFIG_PATH=/etc/wireguard
# DATABASE_PATH=./data/tunnbox.db
# DEBUG=false
# CORS_ORIGINS=http://localhost:5173
